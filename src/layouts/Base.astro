---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** GA4 + Meta Pixel. Solo en home y /gracias — nunca en el formulario (datos de salud). */
  tracking?: boolean;
  noindex?: boolean;
}
const { title, description = site.description, tracking = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — Orientación psicológica puntual`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID;
const nav = [
  ['#situaciones', 'Situaciones'],
  ['#como-funciona', 'Cómo funciona'],
  ['#modalidades', 'Modalidades'],
  ['#quienes-somos', 'Quiénes somos'],
  ['#faq', 'Preguntas'],
];
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta name="theme-color" content="#fcf9f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet" />
    {tracking && GA_ID && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date()); gtag('config', GA_ID);
        </script>
      </Fragment>
    )}
    {tracking && PIXEL_ID && (
      <script is:inline define:vars={{ PIXEL_ID }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', PIXEL_ID); fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-white">Ir al contenido</a>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-hairline/60 bg-surface/85 backdrop-blur-md">
      <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-5 lg:px-12">
        <a href="/" class="flex items-center gap-2.5" aria-label="Primera Pausa, inicio">
          <img src="/favicon.svg" alt="" class="h-8 w-8" />
          <span class="whitespace-nowrap font-serif text-lg font-semibold tracking-tight text-primary sm:text-xl">Primera Pausa</span>
        </a>
        {isHome && (
          <nav class="hidden items-center gap-7 lg:flex" aria-label="Secciones">
            {nav.map(([href, label]) => (
              <a href={href} class="text-sm font-semibold text-ink-soft transition-colors hover:text-primary">{label}</a>
            ))}
          </nav>
        )}
        <a href="/solicitar" class="btn-primary whitespace-nowrap !px-4 !py-2.5 sm:!px-5">
          <span class="material-symbols-outlined hidden sm:inline" aria-hidden="true">chat_bubble</span>
          <span>Necesito hablar</span>
        </a>
      </div>
    </header>

    <main id="contenido" class="pt-18">
      <slot />
    </main>

    <footer class="bg-primary text-primary-fixed-dim">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 lg:grid-cols-12 lg:px-12">
        <div class="lg:col-span-5">
          <p class="font-serif text-2xl text-white">Primera Pausa</p>
          <p class="mt-3 max-w-sm text-sm leading-relaxed">Orientación psicológica puntual, online. No es psicoterapia ni un servicio de urgencias.</p>
        </div>
        <div class="lg:col-span-3">
          <p class="eyebrow !text-secondary-fixed-dim">Contacto</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a class="hover:text-white" href={`https://instagram.com/${site.instagram}`} rel="noopener" target="_blank">@{site.instagram}</a></li>
          </ul>
        </div>
        <div class="lg:col-span-4">
          <p class="eyebrow !text-secondary-fixed-dim">Si estás en una emergencia</p>
          <p class="mt-3 text-sm leading-relaxed">Llamá al <a class="font-semibold text-white underline" href="tel:911">911</a> o a la línea de salud mental <a class="font-semibold text-white underline" href="tel:08009990091">0800-999-0091</a> (gratuita, 24 h).</p>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-6 text-xs sm:flex-row sm:items-center sm:justify-between lg:px-12">
          <p>© {new Date().getFullYear()} Primera Pausa.</p>
          <nav class="flex gap-5" aria-label="Legales">
            <a class="hover:text-white" href="/condiciones-del-servicio">Condiciones del Servicio</a>
            <a class="hover:text-white" href="/politica-de-privacidad">Política de Privacidad</a>
          </nav>
        </div>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

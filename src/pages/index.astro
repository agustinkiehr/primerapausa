---
// src/pages/index.astro - Primera Pausa (Edición Full Bordó Inmersiva, Tipografía Fuerte & Hero Dinámico)
---
<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
  <meta content="Orientación psicológica puntual en sesión única. Una conversación profesional para entender mejor lo que te está pasando, ordenar la situación y pensar cómo abordarla." name="description"/>
  <title>Primera Pausa — Orientación Psicológica Puntual</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <!-- Tipografías con fuerza estructural (Space Grotesk + Plus Jakarta Sans) -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  
  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "bordo-base": "#3d0002",
            "bordo-alt": "#4a0002",
            "bordo-deep": "#280001",
            "bordo-card": "#560508",
            "bordo-card-hover": "#66080c",
            "bordo-border": "#852327",
            "terracota": "#d9531e",
            "terracota-light": "#f07643",
            "marfil": "#fdfbf7",
            "rosado-claro": "#ffdad5",
            "rosado-acento": "#ffc7bf"
          },
          fontFamily: {
            "display": ["Space Grotesk", "sans-serif"],
            "sans": ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>

  <style is:inline>
    html, body {
      margin: 0;
      padding: 0;
      background-color: #3d0002;
      color: #fdfbf7;
    }
    body { overscroll-behavior: none; }
    .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }
    .pt-safe { padding-top: env(safe-area-inset-top, 0px); }
    ::-webkit-scrollbar { display: none; }

    /* Animaciones de aparición progresiva al scrollear */
    .reveal-init {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .reveal-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Secuencia escalonada del Hero */
    .hero-step-1 { opacity: 0; transform: translateY(14px); transition: all 0.6s ease-out; }
    .hero-step-2 { opacity: 0; transform: translateY(14px); transition: all 0.6s ease-out; }
    .hero-step-3 { opacity: 0; transform: translateY(14px); transition: all 0.6s ease-out; }
    .hero-step-visible { opacity: 1 !important; transform: translateY(0) !important; }

    /* Cursor titilante para el efecto escritura en "NECESITÁS HABLAR." */
    @keyframes blinkCursor {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    .typing-cursor {
      display: inline-block;
      width: 6px;
      height: 0.85em;
      background-color: #f07643;
      margin-left: 6px;
      vertical-align: baseline;
      animation: blinkCursor 0.85s infinite;
    }

    /* Flotación suave y legible para las voces ("Entre tantas voces") */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }
    @keyframes floatSlowReverse {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(5px); }
    }
    .voice-pill {
      animation: floatSlow 5s ease-in-out infinite;
    }
    .voice-pill-alt {
      animation: floatSlowReverse 6s ease-in-out infinite;
    }

    /* Control deslizante del Medidor sobre fondo Bordó */
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 24px;
      height: 24px;
      border-radius: 4px;
      background: #f07643;
      border: 2px solid #fdfbf7;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
      transition: transform 0.2s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.12);
    }
    input[type="range"]::-moz-range-thumb {
      width: 24px;
      height: 24px;
      border-radius: 4px;
      background: #f07643;
      border: 2px solid #fdfbf7;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
      transition: transform 0.2s ease;
    }

    /* Destello de foco en tarjetas de precios */
    @keyframes targetFlash {
      0% { transform: scale(1); outline: 2px solid transparent; }
      35% { transform: translateY(-6px) scale(1.02); outline: 3px solid #f07643; box-shadow: 0 20px 45px rgba(0,0,0,0.55); }
      100% { transform: translateY(0) scale(1); outline: 2px solid transparent; }
    }
    .card-target-highlight {
      animation: targetFlash 1.4s ease-out;
    }
  </style>
</head>
<body class="bg-bordo-base font-sans text-marfil antialiased selection:bg-terracota selection:text-white pb-20 lg:pb-0">

<!-- ==================== HEADER STICKY FULL BORDÓ ==================== -->
<header class="sticky top-0 left-0 w-full z-40 bg-[#2d0001]/95 backdrop-blur-md border-b border-bordo-border/50 transition-all duration-300 pt-safe">
  <div class="h-16 lg:h-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex items-center justify-between gap-4">
    <!-- Isotipo '|| Primera Pausa' -->
    <a class="flex items-center gap-3 shrink-0 group" href="#">
      <div class="w-8 h-8 rounded-md bg-terracota text-white flex items-center justify-center font-bold tracking-tighter text-xs shadow-sm group-hover:bg-terracota-light transition-colors">
        <span class="inline-block tracking-[-2px] text-sm font-black">||</span>
      </div>
      <div class="flex flex-col">
        <span class="font-display text-xl sm:text-2xl font-bold tracking-tight text-white leading-none uppercase">Primera Pausa</span>
        <span class="text-[10px] uppercase tracking-[0.2em] text-rosado-claro/80 font-semibold mt-0.5">Orientación Puntual</span>
      </div>
    </a>

    <!-- Navegación Desktop -->
    <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-7 text-sm font-medium text-rosado-claro/90">
      <a class="hover:text-terracota-light transition-colors duration-200" href="#situaciones">Situaciones</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#que-trabajamos">Qué trabajamos</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#como-funciona">Cómo funciona</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#termometro">Medidor</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#modalidades">Modalidades</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#quienes-somos">Quiénes somos</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#preguntas">Preguntas</a>
    </nav>

    <!-- Acciones Derecha (Botón con bordes firmes rounded-md) -->
    <div class="flex items-center gap-2.5 shrink-0">
      <button type="button" onclick="openPausaModal()" class="inline-flex items-center justify-center bg-marfil text-bordo-deep text-xs sm:text-sm font-bold uppercase tracking-wider px-5 py-2.5 rounded-md hover:bg-terracota hover:text-white transition-all duration-200 shadow-sm">
        Necesito hablar
      </button>
      <button type="button" id="mobile-menu-btn" onclick="toggleMobileMenu()" aria-expanded="false" aria-controls="mobile-nav-drawer" aria-label="Abrir menú" class="lg:hidden w-10 h-10 rounded-md bg-bordo-card border border-bordo-border text-white flex items-center justify-center hover:bg-terracota transition-colors">
        <span class="material-symbols-outlined text-[22px]" id="mobile-menu-icon">menu</span>
      </button>
    </div>
  </div>

  <!-- Menú Desplegable Mobile -->
  <div id="mobile-nav-drawer" class="hidden lg:hidden bg-bordo-deep border-b border-bordo-border px-6 py-5 flex-col gap-3 shadow-2xl">
    <a onclick="toggleMobileMenu()" class="py-2 text-sm font-semibold text-white border-b border-bordo-border/40 flex items-center justify-between" href="#situaciones">
      <span>Situaciones frecuentes</span>
      <span class="text-terracota-light font-bold">→</span>
    </a>
    <a onclick="toggleMobileMenu()" class="py-2 text-sm font-semibold text-white border-b border-bordo-border/40 flex items-center justify-between" href="#que-trabajamos">
      <span>¿Qué podemos trabajar?</span>
      <span class="text-terracota-light font-bold">→</span>
    </a>
    <a onclick="toggleMobileMenu()" class="py-2 text-sm font-semibold text-white border-b border-bordo-border/40 flex items-center justify-between" href="#como-funciona">
      <span>Cómo funciona</span>
      <span class="text-terracota-light font-bold">→</span>
    </a>
    <a onclick="toggleMobileMenu()" class="py-2 text-sm font-semibold text-white border-b border-bordo-border/40 flex items-center justify-between" href="#termometro">
      <span>Medidor de Peso Emocional</span>
      <span class="text-terracota-light font-bold">→</span>
    </a>
    <a onclick="toggleMobileMenu()" class="py-2 text-sm font-semibold text-white border-b border-bordo-border/40 flex items-center justify-between" href="#modalidades">
      <span>Modalidades y Tarifas</span>
      <span class="text-terracota-light font-bold">→</span>
    </a>
    <a onclick="toggleMobileMenu()" class="py-2 text-sm font-semibold text-white border-b border-bordo-border/40 flex items-center justify-between" href="#quienes-somos">
      <span>Equipo Profesional</span>
      <span class="text-terracota-light font-bold">→</span>
    </a>
    <a onclick="toggleMobileMenu()" class="py-2 text-sm font-semibold text-white flex items-center justify-between" href="#preguntas">
      <span>Preguntas Frecuentes</span>
      <span class="text-terracota-light font-bold">→</span>
    </a>
  </div>
</header>

<main class="w-full">
  <!-- ==================== 1. HERO SECTION (IMPACTO DINÁMICO Y TIPOGRAFÍA FUERTE) ==================== -->
  <section class="relative w-full bg-bordo-alt text-white overflow-hidden py-14 sm:py-20 lg:py-28 border-b border-bordo-border/60">
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        
        <!-- Columna Izquierda: Titular Colosal con Efecto Escritura en Vivo -->
        <div class="lg:col-span-7 flex flex-col items-start gap-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-bordo-deep border border-bordo-border text-[11px] sm:text-xs uppercase tracking-[0.22em] text-rosado-claro font-bold">
            <span class="w-2 h-2 bg-terracota-light"></span>
            ORIENTACIÓN PSICOLÓGICA PUNTUAL
          </div>

          <!-- Titular Dinámico más grande y con carácter -->
          <div class="min-h-[130px] sm:min-h-[165px] lg:min-h-[195px] flex flex-col justify-center">
            <h1 class="font-display text-6xl sm:text-7xl lg:text-[84px] font-bold tracking-tight text-white leading-[0.96] uppercase">
              <span id="typewriter-line-1"></span>
              <span class="block text-terracota-light mt-1" id="typewriter-line-2"></span>
            </h1>
          </div>

          <!-- Pastilla de contraste firme (aparece en secuencia) -->
          <div id="hero-badge" class="hero-step-1 inline-block px-4 py-2 rounded-md bg-terracota text-white text-sm sm:text-base font-bold uppercase tracking-wider shadow-lg">
            No necesariamente hacer terapia.
          </div>

          <!-- Bajada (aparece en secuencia) -->
          <p id="hero-desc" class="hero-step-2 font-sans text-base sm:text-lg lg:text-xl text-rosado-claro/95 max-w-xl leading-relaxed">
            Una conversación profesional para entender mejor lo que te está pasando, ordenar la situación y pensar cómo abordarla.
          </p>

          <!-- Botones Rectangulares con Carácter (sin bordes redondeados blandos ni iconitos) -->
          <div id="hero-ctas" class="hero-step-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto pt-2">
            <button type="button" onclick="openPausaModal()" class="inline-flex items-center justify-center bg-marfil text-bordo-deep font-bold text-sm sm:text-base uppercase tracking-wider px-8 py-4 rounded-md shadow-[0_10px_28px_rgba(0,0,0,0.35)] hover:bg-terracota hover:text-white transition-all duration-200">
              Necesito hablar
            </button>
            <button type="button" onclick="openPausaModal('Pausa Prioritaria (<24hs - $95.000 ARS)')" class="inline-flex items-center justify-center bg-bordo-deep text-white border-2 border-terracota/80 font-bold text-sm sm:text-base uppercase tracking-wider px-8 py-4 rounded-md hover:bg-terracota hover:border-terracota transition-all duration-200">
              Necesito hablar hoy
            </button>
          </div>

          <div class="hero-step-3 flex items-center gap-2 pt-1 text-xs text-rosado-claro/80" id="hero-disclaimer">
            <span>Turnos sujetos a disponibilidad. No es un servicio de emergencia ni guardia médica.</span>
          </div>
        </div>

        <!-- Columna Derecha: "ENTRE TANTAS VOCES" 100% VISIBLE Y DESTAPADO -->
        <div class="lg:col-span-5 relative reveal-init">
          <div class="relative w-full rounded-xl bg-bordo-deep/90 border border-bordo-border p-6 sm:p-8 shadow-2xl flex flex-col justify-between gap-6">
            
            <!-- Nube superior de voces mentales (Claramente legibles, sin quedar tapadas) -->
            <div class="flex flex-wrap items-center justify-between gap-2.5">
              <span class="voice-pill px-3 py-1.5 rounded bg-bordo-alt/90 border border-bordo-border/70 text-xs sm:text-sm font-semibold text-rosado-claro/90 tracking-wide">
                “YO EN TU LUGAR...”
              </span>
              <span class="voice-pill-alt px-3 py-1.5 rounded bg-bordo-alt/90 border border-bordo-border/70 text-xs sm:text-sm font-semibold text-rosado-claro/75 tracking-wide">
                “TENÉS QUE DEJARLO”
              </span>
              <span class="voice-pill px-3 py-1.5 rounded bg-bordo-alt/90 border border-bordo-border/70 text-xs sm:text-sm font-semibold text-rosado-claro/80 tracking-wide">
                “NO ES PARA TANTO”
              </span>
              <span class="voice-pill-alt px-3 py-1.5 rounded bg-bordo-alt/90 border border-bordo-border/70 text-xs sm:text-sm font-semibold text-rosado-claro/90 tracking-wide">
                “NO LE DES TANTAS VUELTAS”
              </span>
            </div>

            <!-- Pregunta Central Firme y Despejada -->
            <div class="my-2 py-7 px-6 rounded-lg bg-bordo-card border-l-4 border-terracota shadow-lg text-left">
              <span class="text-xs uppercase tracking-[0.25em] text-terracota-light font-bold block mb-2">
                ENTRE TANTAS VOCES EXTERNAS
              </span>
              <h2 class="font-display text-3xl sm:text-4xl font-bold text-white leading-tight">
                ¿Qué necesitás vos?
              </h2>
            </div>

            <!-- Nube inferior de voces mentales -->
            <div class="flex flex-wrap items-center justify-between gap-2.5">
              <span class="voice-pill-alt px-3 py-1.5 rounded bg-bordo-alt/90 border border-bordo-border/70 text-xs sm:text-sm font-semibold text-rosado-claro/85 tracking-wide">
                “DEBERÍAS HABLARLO”
              </span>
              <span class="voice-pill px-3 py-1.5 rounded bg-bordo-alt/90 border border-bordo-border/70 text-xs sm:text-sm font-semibold text-rosado-claro/75 tracking-wide">
                “YA VA A PASAR...”
              </span>
              <span class="voice-pill-alt px-3 py-1.5 rounded bg-bordo-alt/90 border border-bordo-border/70 text-xs sm:text-sm font-semibold text-rosado-claro/90 tracking-wide">
                “PENSÁ EN VOS”
              </span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== 2. SECCIÓN: SITUACIONES (SIN ICONITOS, TIPOGRAFÍA FIRME) ==================== -->
  <section class="w-full bg-bordo-base text-white py-16 sm:py-20 lg:py-28 border-b border-bordo-border/40" id="situaciones">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-12 flex flex-col gap-12 sm:gap-14">
      <div class="max-w-4xl reveal-init">
        <p class="font-display text-2xl sm:text-3xl lg:text-4xl text-white leading-tight font-bold">
          Hay situaciones que no necesitan un tratamiento largo, sino una <span class="text-terracota-light underline decoration-terracota/60 underline-offset-8">conversación a tiempo</span> con alguien que sabe escuchar y ordenar.
        </p>
      </div>

      <!-- 3 Tarjetas con Numeración Editorial Pura (Sin corazoncitos ni valijitas) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <!-- Tarjeta 01: VÍNCULOS -->
        <div onclick="openPausaModalWithArea('Vínculos / Pareja')" class="cursor-pointer bg-bordo-card hover:bg-bordo-card-hover rounded-lg p-7 sm:p-8 border border-bordo-border flex flex-col justify-between min-h-[250px] shadow-lg hover:border-terracota-light transition-all duration-200 reveal-init">
          <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between border-b border-bordo-border/60 pb-3">
              <span class="font-display text-sm font-bold tracking-[0.2em] text-terracota-light uppercase">
                VÍNCULOS
              </span>
              <span class="font-display text-2xl font-bold text-rosado-claro/40">01</span>
            </div>
            <p class="font-display text-xl sm:text-2xl font-bold text-white leading-snug">
              “Discutí con mi pareja y no sé qué hacer.”
            </p>
          </div>
          <div class="pt-5 mt-4 border-t border-bordo-border/30 text-xs sm:text-sm text-rosado-claro/90 font-medium">
            → Desarmar la escalada y clarificar límites saludables.
          </div>
        </div>

        <!-- Tarjeta 02: DECISIONES -->
        <div onclick="openPausaModalWithArea('Toma de decisiones')" class="cursor-pointer bg-bordo-card hover:bg-bordo-card-hover rounded-lg p-7 sm:p-8 border border-bordo-border flex flex-col justify-between min-h-[250px] shadow-lg hover:border-terracota-light transition-all duration-200 reveal-init" style="transition-delay: 100ms;">
          <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between border-b border-bordo-border/60 pb-3">
              <span class="font-display text-sm font-bold tracking-[0.2em] text-terracota-light uppercase">
                DECISIONES
              </span>
              <span class="font-display text-2xl font-bold text-rosado-claro/40">02</span>
            </div>
            <p class="font-display text-xl sm:text-2xl font-bold text-white leading-snug">
              “Tengo que tomar una decisión importante y estoy trabadísima.”
            </p>
          </div>
          <div class="pt-5 mt-4 border-t border-bordo-border/30 text-xs sm:text-sm text-rosado-claro/90 font-medium">
            → Mitigar la parálisis y ordenar alternativas posibles.
          </div>
        </div>

        <!-- Tarjeta 03: TRABAJO -->
        <div onclick="openPausaModalWithArea('Trabajo / Rumia laboral')" class="cursor-pointer bg-bordo-card hover:bg-bordo-card-hover rounded-lg p-7 sm:p-8 border border-bordo-border flex flex-col justify-between min-h-[250px] shadow-lg hover:border-terracota-light transition-all duration-200 reveal-init" style="transition-delay: 200ms;">
          <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between border-b border-bordo-border/60 pb-3">
              <span class="font-display text-sm font-bold tracking-[0.2em] text-terracota-light uppercase">
                TRABAJO
              </span>
              <span class="font-display text-2xl font-bold text-rosado-claro/40">03</span>
            </div>
            <p class="font-display text-xl sm:text-2xl font-bold text-white leading-snug">
              “Pasó algo en el trabajo y no puedo dejar de pensarlo.”
            </p>
          </div>
          <div class="pt-5 mt-4 border-t border-bordo-border/30 text-xs sm:text-sm text-rosado-claro/90 font-medium">
            → Despejar la rumia y recuperar serenidad operativa.
          </div>
        </div>
      </div>

      <!-- Módulo Inferior: Lista de situaciones orientativas -->
      <div class="bg-bordo-deep/90 rounded-lg p-7 sm:p-10 border border-bordo-border flex flex-col lg:flex-row gap-8 lg:gap-16 items-start justify-between reveal-init">
        <div class="max-w-md flex flex-col gap-2">
          <h3 class="font-display text-2xl lg:text-3xl font-bold text-white leading-tight">
            ¿En qué situaciones podemos orientarte?
          </h3>
          <p class="text-sm text-rosado-claro/85">
            Algunos ejemplos de lo que suele traer a una Primera Pausa:
          </p>
        </div>
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm sm:text-base text-marfil font-medium">
          <div class="flex items-start gap-3">
            <span class="text-terracota-light font-bold">→</span>
            <span>Algo que pasó hoy y necesitás pensar.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota-light font-bold">→</span>
            <span>Una decisión que no sabés cómo abordar.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota-light font-bold">→</span>
            <span>Un conflicto de pareja o familiar.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota-light font-bold">→</span>
            <span>Un conflicto laboral o profesional.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota-light font-bold">→</span>
            <span>Preparar una conversación importante.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota-light font-bold">→</span>
            <span>Algo que te está generando preocupación, angustia o confusión.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. SECCIÓN: ¿QUÉ PODEMOS TRABAJAR? (LA SECCIÓN FAVORITA DEL CLIENTE) ==================== -->
  <section class="w-full bg-bordo-alt text-white py-16 sm:py-20 lg:py-28 border-b border-bordo-border/40" id="que-trabajamos">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-12 flex flex-col gap-12 sm:gap-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 sm:gap-8 reveal-init">
        <div class="max-w-2xl flex flex-col gap-2">

---
import Base from '../layouts/Base.astro';
import CtaPair from '../components/CtaPair.astro';
import {
  hero, insight, situaciones, expectativas, pasos, alcance, modalidades,
  profesionales, faq, formatPrice,
} from '../data/site';

const initials = (n: string) => n.replace(/^Lic\.\s*/, '').split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase();
---
<Base tracking>
  <!-- HERO -->
  <section class="relative overflow-hidden py-14 lg:py-24">
    <div aria-hidden="true" class="aura pointer-events-none absolute -left-40 -top-40 h-[640px] w-[640px] rounded-full bg-gradient-to-br from-secondary-container/50 via-primary-fixed/30 to-transparent blur-3xl lg:h-[850px] lg:w-[850px]"></div>
    <div aria-hidden="true" class="aura pointer-events-none absolute -bottom-48 right-0 h-[550px] w-[550px] rounded-full bg-gradient-to-tl from-secondary-fixed/40 via-surface-high/50 to-transparent blur-3xl" style="animation-delay:3s"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 lg:grid-cols-12 lg:gap-8 lg:px-12">
      <div class="reveal flex flex-col items-start gap-6 lg:col-span-7">
        <span class="inline-flex items-center gap-2 rounded-full border border-secondary-container/70 bg-secondary-container/40 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-primary">
          <span class="h-2 w-2 animate-pulse rounded-full bg-tint"></span>{hero.eyebrow}
        </span>
        <h1 class="text-[2.6rem] leading-[1.15] tracking-tight sm:text-6xl sm:leading-[1.1]">{hero.title}</h1>
        <p class="max-w-xl text-lg leading-relaxed text-ink-soft">{hero.lead}</p>
        <div class="w-full pt-2 sm:w-auto"><CtaPair /></div>
      </div>

      <!-- Respiración guiada -->
      <div class="reveal lg:col-span-5" style="transition-delay:.2s">
        <div class="relative mx-auto max-w-md">
          <div aria-hidden="true" class="absolute -inset-4 -z-10 -rotate-2 rounded-[3rem] bg-gradient-to-tr from-secondary-container/40 via-surface-high/60 to-surface-low"></div>
          <div class="card flex flex-col items-center gap-6 px-8 py-10 text-center shadow-[0_20px_50px_rgba(67,0,1,0.08)]" id="breathe">
            <p class="eyebrow">Antes de seguir, una pausa</p>
            <div class="relative flex h-44 w-44 items-center justify-center">
              <div id="b-outer" class="absolute inset-0 rounded-full bg-secondary-container/50 transition-all duration-[3800ms] ease-in-out"></div>
              <div id="b-inner" class="relative flex h-24 w-24 items-center justify-center rounded-full bg-primary-container text-white shadow-inner transition-all duration-[3800ms] ease-in-out">
                <span class="material-symbols-outlined !text-3xl" aria-hidden="true">spa</span>
              </div>
            </div>
            <div aria-live="polite">
              <p id="b-phase" class="font-serif text-xl text-primary">Tomate un instante</p>
              <p id="b-sub" class="mt-1 text-sm text-ink-soft">Inhalá, sostené y soltá el aire, 4 segundos cada vez.</p>
            </div>
            <button id="b-btn" type="button" class="btn-soft !py-2.5">
              <span class="material-symbols-outlined" aria-hidden="true" id="b-icon">play_arrow</span>
              <span id="b-label">Respirar conmigo</span>
            </button>
          </div>
          <div class="absolute -bottom-6 -left-3 flex items-center gap-3 rounded-2xl bg-surface-lowest/95 p-4 shadow-[0_12px_36px_rgba(67,0,1,0.09)] backdrop-blur sm:-left-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary-container/50 text-primary"><span class="material-symbols-outlined" aria-hidden="true">headset_mic</span></span>
            <span class="flex flex-col text-left">
              <span class="text-xs font-semibold uppercase tracking-wider text-primary">Online</span>
              <span class="text-sm text-ink-soft">Audio o videollamada</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INSIGHT / SITUACIONES -->
  <section id="situaciones" class="bg-primary py-20 text-white lg:py-28">
    <div class="mx-auto flex max-w-7xl flex-col gap-14 px-5 lg:px-12">
      <div class="reveal flex max-w-3xl flex-col gap-5">
        <span class="eyebrow !text-secondary-fixed">{insight.eyebrow}</span>
        <h2 class="text-3xl leading-tight !text-primary-fixed sm:text-4xl">“{insight.quote}”</h2>
        <p class="text-lg leading-relaxed text-primary-fixed-dim">{insight.lead}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {insight.phrases.slice(0, 3).map((p, i) => (
          <div class="reveal flex flex-col gap-4 rounded-3xl border border-white/10 bg-primary-container/70 p-8" style={`transition-delay:${i * 0.1}s`}>
            <span class="material-symbols-outlined !text-3xl text-secondary-fixed-dim" aria-hidden="true">{p.icon}</span>
            <p class="font-serif text-xl leading-snug text-white">“{p.text}”</p>
          </div>
        ))}
      </div>

      <div class="reveal grid gap-10 rounded-3xl border border-white/10 bg-white/5 p-8 lg:grid-cols-2 lg:p-12">
        <div>
          <h3 class="text-2xl !text-primary-fixed">¿En qué situaciones podemos orientarte?</h3>
          <p class="mt-3 text-primary-fixed-dim">Algunos ejemplos de lo que suele traer a una Primera Pausa:</p>
        </div>
        <ul class="grid gap-3">
          {situaciones.map((s) => (
            <li class="flex items-start gap-3 text-primary-fixed">
              <span class="material-symbols-outlined mt-0.5 text-secondary-fixed-dim" aria-hidden="true">east</span>{s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- MEDIDOR -->
  <section class="border-y border-outline-soft/30 bg-surface-high/60 py-16 lg:py-20">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-10 px-5 lg:px-12">
      <div class="reveal flex flex-col items-center gap-3 text-center">
        <span class="eyebrow">Para orientarte</span>
        <h2 class="text-3xl sm:text-4xl">¿Cuánto te está pesando?</h2>
        <p class="max-w-xl text-ink-soft">Mové el control y te sugerimos qué modalidad podría acompañarte mejor. Es solo una guía, no una evaluación.</p>
      </div>
      <div class="reveal card flex w-full flex-col gap-8 p-6 shadow-[0_8px_32px_rgba(67,0,1,0.06)] sm:p-10" id="medidor">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-surface-mid pb-5">
          <p id="m-title" class="font-serif text-2xl text-primary">Me da vueltas en la cabeza</p>
          <span id="m-badge" class="rounded-full border border-secondary-container/60 bg-secondary-container/40 px-4 py-1.5 text-sm font-semibold text-primary">Nivel 2 de 5</span>
        </div>
        <div class="flex flex-col gap-3">
          <input id="m-range" type="range" min="1" max="5" step="1" value="2" aria-label="Cuánto te está pesando, de 1 a 5" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-surface-mid" />
          <div class="flex justify-between text-xs font-semibold text-outline"><span>Leve</span><span>Me supera</span></div>
        </div>
        <div class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-surface-low p-6 md:flex-row md:items-center">
          <div>
            <p id="m-tag" class="eyebrow">Sugerencia: Pausa Breve (30 min)</p>
            <p id="m-text" class="mt-1 leading-relaxed">A veces alcanza con desenredar un pensamiento que se repite antes de que crezca.</p>
          </div>
          <a id="m-cta" href="/solicitar?modalidad=breve" class="btn-primary w-full shrink-0 md:w-auto">Solicitar esta consulta</a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUÉ ESPERAR -->
  <section class="bg-surface-low py-20 lg:py-28">
    <div class="mx-auto flex max-w-7xl flex-col gap-14 px-5 lg:px-12">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="flex max-w-2xl flex-col gap-3">
          <span class="eyebrow">Una conversación con foco</span>
          <h2 class="text-3xl sm:text-4xl">¿Qué podés esperar de este espacio?</h2>
        </div>
        <p class="max-w-sm text-ink-soft">Trabajamos sobre lo que hoy te genera malestar, para que salgas con más claridad y un próximo paso posible.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {expectativas.map((e, i) => (
          <div class="reveal card flex flex-col gap-5 p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(67,0,1,0.06)]" style={`transition-delay:${i * 0.08}s`}>
            <span class="font-serif text-4xl text-secondary-fixed-dim">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-xl font-semibold">{e.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{e.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="reveal"><CtaPair /></div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section id="como-funciona" class="py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 lg:grid-cols-12 lg:px-12">
      <div class="reveal flex flex-col gap-4 lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
        <span class="eyebrow">Paso a paso</span>
        <h2 class="text-3xl sm:text-4xl">¿Cómo funciona Primera Pausa?</h2>
        <p class="rounded-2xl border border-secondary-fixed-dim/60 bg-secondary-container/20 p-5 text-sm leading-relaxed text-ink">
          <strong>Completar el formulario no implica que la consulta esté confirmada.</strong> La confirmación se realiza una vez revisada la solicitud, coordinado el horario y reservado el turno.
        </p>
      </div>
      <ol class="flex flex-col lg:col-span-7">
        {pasos.map((p, i) => (
          <li class="reveal relative flex gap-5 pb-8 last:pb-0">
            {i < pasos.length - 1 && <span aria-hidden="true" class="absolute left-5 top-11 bottom-1 w-px bg-outline-soft"></span>}
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-container font-serif text-white">{i + 1}</span>
            <p class="pt-2 leading-relaxed">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ALCANCE -->
  <section class="px-5 pb-20 lg:px-12 lg:pb-28">
    <div class="reveal mx-auto max-w-5xl rounded-3xl bg-surface-mid p-8 sm:p-12">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined !text-3xl text-primary" aria-hidden="true">balance</span>
        <h2 class="text-2xl sm:text-3xl">Alcance de Primera Pausa</h2>
      </div>
      <p class="mt-5 text-lg leading-relaxed">{alcance.intro}</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-3">
        {alcance.items.map((it) => (
          <li class="flex gap-2 rounded-2xl bg-surface-lowest p-5 text-sm leading-relaxed"><span class="material-symbols-outlined text-tint" aria-hidden="true">do_not_disturb_on</span>{it}</li>
        ))}
      </ul>
      <p class="mt-6 text-ink-soft">{alcance.outro}</p>
    </div>
  </section>

  <!-- MODALIDADES -->
  <section id="modalidades" class="bg-surface-low py-20 lg:py-28">
    <div class="mx-auto flex max-w-7xl flex-col gap-14 px-5 lg:px-12">
      <div class="reveal mx-auto flex max-w-2xl flex-col gap-4 text-center">
        <span class="eyebrow">Modalidades</span>
        <h2 class="text-3xl sm:text-4xl">Elegí el espacio que necesitás</h2>
        <p class="text-ink-soft">Podés elegir la modalidad que mejor se adapte a la situación que querés conversar. Si tenés dudas, podemos orientarte antes de coordinar el turno.</p>
      </div>
      <div class="grid items-stretch gap-6 md:grid-cols-2 lg:grid-cols-4">
        {modalidades.map((m, i) => (
          <article id={`card-${m.id}`} class:list={[
            'reveal relative flex flex-col justify-between gap-8 rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1.5',
            m.featured ? 'border-2 border-primary/25 bg-surface-lowest shadow-[0_12px_40px_rgba(107,0,3,0.08)]' : m.priority ? 'border border-hairline bg-surface-high' : 'border border-hairline bg-surface-lowest',
          ]} style={`transition-delay:${i * 0.08}s`}>
            {m.featured && <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-primary-container px-4 py-1 text-xs font-semibold uppercase tracking-wider text-white">Más elegida</span>}
            <div class="flex flex-col gap-3">
              {m.priority
                ? <span class="inline-flex w-fit items-center gap-1 rounded-full bg-secondary-container px-3 py-1 text-xs font-semibold text-primary"><span class="material-symbols-outlined" aria-hidden="true">bolt</span>Dentro de las próximas 24 h</span>
                : <span class="text-sm font-semibold text-secondary">{m.duration}</span>}
              <h3 class="text-2xl">{m.name}</h3>
              <p class="flex items-baseline gap-1.5"><span class="font-serif text-4xl text-primary">{formatPrice(m.price)}</span><span class="text-xs font-semibold text-outline">ARS</span></p>
              <p class="text-sm text-outline">{m.duration} · Audio o videollamada</p>
              <p class="pt-1 text-sm leading-relaxed text-ink-soft">{m.description}</p>
              {m.note && <p class="text-xs leading-relaxed text-secondary">{m.note}</p>}
            </div>
            <a href={`/solicitar?modalidad=${m.id}${m.priority ? '&tipo=prioritaria' : ''}`} class={m.featured || m.priority ? 'btn-primary w-full' : 'btn-soft w-full'}>Elegir {m.name}</a>
          </article>
        ))}
      </div>
      <div class="reveal flex justify-center"><CtaPair center /></div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS -->
  <section id="quienes-somos" class="py-20 lg:py-28">
    <div class="mx-auto flex max-w-7xl flex-col gap-14 px-5 lg:px-12">
      <div class="reveal flex max-w-2xl flex-col gap-4">
        <span class="eyebrow">Quiénes somos</span>
        <h2 class="text-3xl sm:text-4xl">Las profesionales detrás de tu pausa</h2>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        {profesionales.map((p, i) => (
          <article class="reveal card flex flex-col items-start gap-7 p-8 sm:flex-row lg:p-10" style={`transition-delay:${i * 0.1}s`}>
            {p.foto
              ? <img src={p.foto} alt={`Retrato de ${p.nombre}`} class="h-32 w-32 shrink-0 rounded-full object-cover" loading="lazy" />
              : <span class="flex h-32 w-32 shrink-0 items-center justify-center rounded-full bg-secondary-container/50 font-serif text-4xl text-primary" aria-hidden="true">{initials(p.nombre)}</span>}
            <div class="flex flex-col gap-3">
              <div>
                <h3 class="text-2xl">{p.nombre}</h3>
                <p class="text-sm text-ink-soft">{p.titulo}</p>
                <p class="mt-1 text-xs font-semibold tracking-wide text-secondary">{p.matricula}</p>
              </div>
              <p class="text-sm leading-relaxed text-ink-soft">{p.bio}</p>
              <ul class="flex flex-wrap gap-2">
                {p.enfoque.map((e) => <li class="rounded-full bg-secondary-container/30 px-3 py-1 text-xs font-semibold text-primary">{e}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-surface-low py-20 lg:py-28">
    <div class="mx-auto flex max-w-3xl flex-col gap-12 px-5 lg:px-12">
      <div class="reveal flex flex-col items-center gap-3 text-center">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 class="text-3xl sm:text-4xl">Despejando dudas</h2>
      </div>
      <div class="flex flex-col gap-3">
        {faq.map((f) => (
          <details class="group rounded-2xl border border-transparent bg-surface-lowest p-6 transition hover:border-hairline open:border-hairline">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg font-semibold text-primary [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="material-symbols-outlined text-secondary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">expand_more</span>
            </summary>
            <p class="pt-4 leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-primary-container py-20 text-white">
    <div class="reveal mx-auto flex max-w-3xl flex-col items-center gap-7 px-5 text-center">
      <h2 class="text-4xl !text-white sm:text-5xl">¿Necesitás hablar?</h2>
      <p class="text-lg text-primary-fixed-dim">Contanos brevemente qué te está pasando. Revisamos tu solicitud y te contactamos para coordinar.</p>
      <CtaPair dark center />
    </div>
  </section>

  <!-- EMERGENCIA -->
  <section class="px-5 py-12 lg:px-12">
    <div class="mx-auto flex max-w-5xl flex-col gap-3 rounded-3xl border border-outline-soft bg-surface-lowest p-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm leading-relaxed"><strong>¿Estás en una emergencia?</strong> Primera Pausa no brinda atención de urgencias. Si existe riesgo inmediato para vos o para otra persona, comunicate con el 911 o acercate a la guardia más cercana.</p>
      <a href="/lineas-de-ayuda" class="btn-soft shrink-0 !py-2.5">Ver líneas de ayuda</a>
    </div>
  </section>
</Base>

<script>
  // Respiración guiada
  const btn = document.getElementById('b-btn')!;
  const outer = document.getElementById('b-outer')!;
  const inner = document.getElementById('b-inner')!;
  const phase = document.getElementById('b-phase')!;
  const sub = document.getElementById('b-sub')!;
  const label = document.getElementById('b-label')!;
  const icon = document.getElementById('b-icon')!;
  const phases = [
    ['Inhalá…', 'Llená los pulmones despacio.', 1.35],
    ['Sostené…', 'Quedate un momento ahí.', 1.35],
    ['Soltá…', 'Dejá ir el aire y la tensión.', 1],
  ] as const;
  let timer: number | undefined; let i = 0;
  const step = () => {
    const [t, s, scale] = phases[i];
    phase.textContent = t; sub.textContent = s;
    outer.style.transform = `scale(${scale})`; inner.style.transform = `scale(${scale === 1 ? 1 : 1.15})`;
    i = (i + 1) % phases.length;
  };
  btn.addEventListener('click', () => {
    if (timer) {
      clearInterval(timer); timer = undefined; i = 0;
      label.textContent = 'Respirar conmigo'; icon.textContent = 'play_arrow';
      phase.textContent = 'Bien hecho'; sub.textContent = 'Si querés seguir pensándolo con alguien, estamos acá.';
      outer.style.transform = inner.style.transform = 'scale(1)';
    } else {
      label.textContent = 'Pausar'; icon.textContent = 'pause';
      step(); timer = window.setInterval(step, 4000);
    }
  });

  // Medidor
  const levels = [
    { t: 'Algo me quedó dando vueltas', tag: 'Sugerencia: Pausa Breve (30 min)', txt: 'Una conversación corta puede alcanzar para ordenar una situación puntual.', id: 'breve' },
    { t: 'Me da vueltas en la cabeza', tag: 'Sugerencia: Pausa Breve (30 min)', txt: 'A veces alcanza con desenredar un pensamiento que se repite antes de que crezca.', id: 'breve' },
    { t: 'Estoy trabada/o', tag: 'Sugerencia: Pausa Estándar (60 min)', txt: 'Más tiempo para entender qué está en juego y explorar opciones con calma.', id: 'estandar' },
    { t: 'Me siento desbordada/o', tag: 'Sugerencia: Pausa Extendida (90 min) o Prioritaria', txt: 'Cuando hay muchas cosas mezcladas, conviene darse más tiempo o hablar lo antes posible.', id: 'extendida' },
    { t: 'Me supera', tag: 'Primero, tu seguridad', txt: 'Si sentís que no podés sostenerlo o pensás en hacerte daño, llamá ahora al 0800-999-0091 (gratuito, 24 h) o al 911. Primera Pausa no es un servicio de urgencias.', id: null },
  ];
  const range = document.getElementById('m-range') as HTMLInputElement;
  const set = () => {
    const v = Number(range.value); const l = levels[v - 1];
    document.getElementById('m-title')!.textContent = l.t;
    document.getElementById('m-badge')!.textContent = `Nivel ${v} de 5`;
    document.getElementById('m-tag')!.textContent = l.tag;
    document.getElementById('m-text')!.textContent = l.txt;
    const cta = document.getElementById('m-cta') as HTMLAnchorElement;
    if (l.id) { cta.href = `/solicitar?modalidad=${l.id}`; cta.textContent = 'Solicitar esta consulta'; }
    else { cta.href = '/lineas-de-ayuda'; cta.textContent = 'Ver líneas de ayuda'; }
  };
  range.addEventListener('input', set);
</script>

<script is:inline>
  // 1. Efecto Typewriter Dinámico al entrar ("NECESITÁS HABLAR.") + Secuencia escalonada
  document.addEventListener('DOMContentLoaded', () => {
    const line1El = document.getElementById('typewriter-line-1');
    const line2El = document.getElementById('typewriter-line-2');
    const text1 = "NECESITÁS";
    const text2 = "HABLAR.";
    let i = 0;
    let j = 0;

    line1El.innerHTML = '<span class="typing-cursor"></span>';

    function typeLine1() {
      if (i < text1.length) {
        line1El.innerHTML = text1.slice(0, i + 1) + '<span class="typing-cursor"></span>';
        i++;
        setTimeout(typeLine1, 55);
      } else {
        line1El.innerHTML = text1;
        line2El.innerHTML = '<span class="typing-cursor"></span>';
        setTimeout(typeLine2, 120);
      }
    }

    function typeLine2() {
      if (j < text2.length) {
        line2El.innerHTML = text2.slice(0, j + 1) + '<span class="typing-cursor"></span>';
        j++;
        setTimeout(typeLine2, 65);
      } else {
        // Revelar progresivamente la pastilla, el texto y los botones
        document.getElementById('hero-badge')?.classList.add('hero-step-visible');
        setTimeout(() => {
          document.getElementById('hero-desc')?.classList.add('hero-step-visible');
        }, 180);
        setTimeout(() => {
          document.getElementById('hero-ctas')?.classList.add('hero-step-visible');
          document.getElementById('hero-disclaimer')?.classList.add('hero-step-visible');
        }, 360);
      }
    }

    setTimeout(typeLine1, 180);
  });

  // 2. Menú Mobile
  function toggleMobileMenu() {
    const drawer = document.getElementById('mobile-nav-drawer');
    const btn = document.getElementById('mobile-menu-btn');
    const icon = document.getElementById('mobile-menu-icon');
    const isHidden = drawer.classList.contains('hidden');

    if (isHidden) {
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
      btn.setAttribute('aria-expanded', 'true');
      icon.innerText = 'close';
    } else {
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
      btn.setAttribute('aria-expanded', 'false');
      icon.innerText = 'menu';
    }
  }

  // 3. Medidor de Peso Emocional
  const mentalSlider = document.getElementById('mental-load-slider');
  const sliderLevelTitle = document.getElementById('slider-level-title');
  const sliderIntensityBadge = document.getElementById('slider-intensity-badge');
  const sliderSuggestionTag = document.getElementById('slider-suggestion-tag');
  const sliderMessageText = document.getElementById('slider-message-text');
  const sliderTickBtns = document.querySelectorAll('.slider-tick-btn');

  const mentalLevels = {
    1: {
      title: "Nivel 1: Ruido ligero",
      badge: "Claridad general",
      suggestion: "Sugerencia: Pausa Breve (30 min)",
      message: "“A veces solo hace falta desenredar un pensamiento incipiente antes de que crezca y tome más espacio.”",
      cardId: "card-breve",
      modalOption: "Pausa Breve (30 min - $45.000 ARS)"
    },
    2: {
      title: "Nivel 2: Rumia mental",
      badge: "Fricción incipiente",
      suggestion: "Sugerencia: Pausa Breve (30 min) o Estándar (60 min)",
      message: "“A veces solo hace falta desenredar un pensamiento recurrente antes de que crezca. Una conversación a tiempo devuelve el control.”",
      cardId: "card-estandar",
      modalOption: "Pausa Estándar (60 min - $70.000 ARS)"
    },
    3: {
      title: "Nivel 3: Trabada en un dilema",
      badge: "Parálisis por análisis",
      suggestion: "Sugerencia: Pausa Estándar (60 min)",
      message: "“La sensación de estar trabada consume más energía que la decisión misma. Vamos a ordenarlo juntas paso a paso.”",
      cardId: "card-estandar",
      modalOption: "Pausa Estándar (60 min - $70.000 ARS)"
    },
    4: {
      title: "Nivel 4: Carga abrumadora",
      badge: "Saturación emocional",
      suggestion: "Sugerencia: Pausa Extendida (90 min)",
      message: "“Cuando todo se siente urgente, una pausa guiada de 60 o 90 min te devuelve el eje y baja la sobrecarga hoy mismo.”",
      cardId: "card-extendida",
      modalOption: "Pausa Extendida (90 min - $90.000 ARS)"
    },
    5: {
      title: "Nivel 5: Al límite",
      badge: "Atención prioritaria",
      suggestion: "Sugerencia: Pausa Prioritaria (<24hs)",
      message: "“Cuando la angustia o el estrés te desbordan, contar con una profesional en el día es la prioridad.”",
      cardId: "card-prioritaria",
      modalOption: "Pausa Prioritaria (<24hs - $95.000 ARS)"
    }
  };

  let currentSliderLevel = 2;

  function updateSlider(val) {
    currentSliderLevel = Number(val);
    const data = mentalLevels[currentSliderLevel];
    if (!data) return;

    sliderLevelTitle.innerText = data.title;
    sliderIntensityBadge.innerText = data.badge;
    sliderSuggestionTag.innerText = data.suggestion;
    sliderMessageText.innerText = data.message;

    sliderTickBtns.forEach(btn => {
      const isSelected = btn.getAttribute('data-val') === String(val);
      btn.classList.toggle('font-bold', isSelected);
      btn.classList.toggle('text-terracota-light', isSelected);
    });
  }

  if (mentalSlider) {
    mentalSlider.addEventListener('input', (e) => updateSlider(e.target.value));
    sliderTickBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val');
        mentalSlider.value = val;
        updateSlider(val);
      });
    });
  }

  function scrollToRecommendedCard() {
    const data = mentalLevels[currentSliderLevel];
    const targetCard = document.getElementById(data ? data.cardId : 'card-estandar');
    if (!targetCard) return;

    targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
    targetCard.classList.remove('card-target-highlight');
    void targetCard.offsetWidth;
    targetCard.classList.add('card-target-highlight');
  }

  // 4. Control del Modal
  function openPausaModal(defaultModalidad) {
    const modal = document.getElementById('pausa-form-modal');
    const panel = document.getElementById('pausa-modal-panel');
    const select = document.getElementById('form-modalidad');

    if (defaultModalidad && select) {
      select.value = defaultModalidad;
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      panel.classList.remove('scale-95');
    });
  }

  function openPausaModalWithArea(areaValue) {
    const radios = document.querySelectorAll('input[name="situacion"]');
    radios.forEach(r => {
      r.checked = (r.value === areaValue);
    });
    openPausaModal();
  }

  function openPausaModalFromSlider() {
    const data = mentalLevels[currentSliderLevel];
    openPausaModal(data ? data.modalOption : null);
  }

  function closePausaModal() {
    const modal = document.getElementById('pausa-form-modal');
    const panel = document.getElementById('pausa-modal-panel');
    modal.classList.add('opacity-0');
    panel.classList.add('scale-95');
    modal.setAttribute('aria-hidden', 'true');
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }, 250);
  }

  document.getElementById('pausa-form-modal').addEventListener('click', (e) => {
    if (e.target.id === 'pausa-form-modal') closePausaModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePausaModal();
  });

  function submitPausaForm(e) {
    e.preventDefault();
    const form = e.target;
    const situacion = form.situacion.value;
    const modalidad = form.modalidad.value;
    const contexto = document.getElementById('form-contexto').value.trim();
    const horario = document.getElementById('form-horario').value.trim();

    let mensaje = "Hola, completé el formulario en Primera Pausa.\n\n" +
                  "• *Área:* " + situacion + "\n" +
                  "• *Modalidad:* " + modalidad + "\n" +
                  "• *Nombre y disponibilidad:* " + horario;
    if (contexto) {
      mensaje += "\n• *Motivo:* " + contexto;
    }

    const waUrl = "https://wa.me/?text=" + encodeURIComponent(mensaje);
    window.open(waUrl, '_blank', 'noopener,noreferrer');
    closePausaModal();
  }

  // 5. Acordeón de Preguntas Frecuentes
  document.querySelectorAll('.faq-trigger').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.faq-item');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      const isOpen = !content.classList.contains('hidden');

      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => i.classList.remove('rotate-180'));
      document.querySelectorAll('.faq-trigger').forEach(b => b.setAttribute('aria-expanded', 'false'));

      if (!isOpen) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // 6. IntersectionObserver para revelados suaves
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-visible');
        obs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.reveal-init').forEach(el => observer.observe(el));
</script>
</body>
</html>

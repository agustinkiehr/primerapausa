---
// src/pages/index.astro — Base 100% fiel a code landing.html de Stitch + 7 retoques puntuales de Lucía y Barbi
---
<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Primera Pausa — Orientación Psicológica Puntual</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  
  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#4a0002",
            "primary-dark": "#360002",
            "primary-container": "#6b0003",
            "on-primary": "#ffffff",
            "terracota": "#d9531e",
            "terracota-light": "#e06d3b",
            "terracota-warm": "#d87444",
            "surface": "#fcf9f3",
            "surface-dim": "#f5f0e6",
            "surface-container-low": "#f6f3ed",
            "surface-container": "#f0eee8",
            "surface-container-high": "#ebe8e2",
            "surface-container-lowest": "#ffffff",
            "on-surface": "#1c1c18",
            "on-surface-variant": "#58413e",
            "secondary-container": "#ffc7bf",
            "secondary-fixed": "#ffdad5",
            "secondary-fixed-dim": "#f0bab1",
            "outline": "#8c716d",
            "outline-variant": "#e0bfbb",
            "surface-tint": "#ab3329",
          },
          fontFamily: {
            "serif": ["Playfair Display", "serif"],
            "sans": ["Plus Jakarta Sans", "sans-serif"],
            "display-lg": ["Playfair Display", "serif"],
            "headline-lg": ["Playfair Display", "serif"],
            "headline-md": ["Playfair Display", "serif"],
            "headline-sm": ["Playfair Display", "serif"],
            "body-lg": ["Plus Jakarta Sans", "sans-serif"],
            "body-md": ["Plus Jakarta Sans", "sans-serif"],
            "body-sm": ["Plus Jakarta Sans", "sans-serif"],
            "label-md": ["Plus Jakarta Sans", "sans-serif"],
            "label-sm": ["Plus Jakarta Sans", "sans-serif"],
          },
          borderRadius: {
            "DEFAULT": "1rem",
            "lg": "1.75rem",
            "xl": "2.5rem",
            "full": "9999px"
          }
        }
      }
    };
  </script>

  <style is:inline>
    html, body { margin: 0; padding: 0; background-color: #3d0002; }
    body { overscroll-behavior: none; }
    ::-webkit-scrollbar { display: none; }

    /* Subtle reveals and animations */
    .reveal-init {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .reveal-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Ambient pulse glow */
    @keyframes subtlePulse {
      0%, 100% { opacity: 0.18; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(1.08); }
    }
    .animate-ambient-glow {
      animation: subtlePulse 7s ease-in-out infinite;
    }

    /* Voces de fondo en "Entre tantas voces" ahora visibles y legibles */
    .chatter-voice {
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
      opacity: 0.55;
      color: #ffdad5;
      user-select: none;
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .chatter-voice:hover {
      opacity: 0.95;
      transform: scale(1.03);
    }

    /* Cursor sutil para la escritura inicial de NECESITÁS hablar. */
    @keyframes blinkCaret {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    .type-caret {
      display: inline-block;
      width: 3px;
      height: 0.85em;
      background-color: #e06d3b;
      margin-left: 4px;
      vertical-align: baseline;
      animation: blinkCaret 0.8s infinite;
    }

    /* Range slider custom thumb */
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #e06d3b;
      border: 3px solid #ffdad5;
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
      transition: transform 0.2s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }

    /* Target highlight flash for pricing cards */
    @keyframes targetFlash {
      0% { transform: scale(1); outline: 2px solid transparent; }
      35% { transform: translateY(-6px) scale(1.02); outline: 3px solid #e06d3b; box-shadow: 0 20px 40px rgba(0,0,0,0.45); }
      100% { transform: translateY(0) scale(1); outline: 2px solid transparent; }
    }
    .card-target-highlight {
      animation: targetFlash 1.3s ease-out;
    }
  </style>
</head>
<body class="bg-[#3d0002] font-sans text-white antialiased selection:bg-terracota selection:text-white">

<!-- ==================== HEADER ORIGINAL STITCH (con botón sin dibujito y borde suave) ==================== -->
<header class="sticky top-0 left-0 w-full z-50 bg-[#3d0002]/95 backdrop-blur-md border-b border-[#631014] transition-all duration-300">
  <div class="h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-6">
    <!-- Brand Logo '|| Primera Pausa' -->
    <a class="flex items-center gap-3 shrink-0 group" href="#">
      <div class="w-7 h-7 rounded-full bg-terracota text-white flex items-center justify-center font-bold tracking-tighter text-xs shadow-sm group-hover:scale-105 transition-transform duration-200">
        <span class="inline-block tracking-[-2px] text-sm font-black">||</span>
      </div>
      <span class="font-serif text-2xl font-bold tracking-tight text-white">Primera Pausa</span>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden lg:flex items-center gap-8 text-[15px] font-medium text-[#ffdad5]/85">
      <a class="hover:text-terracota-light transition-colors duration-200" href="#situaciones">Situaciones</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#como-funciona">Cómo funciona</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#que-trabajamos">Qué trabajamos</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#modalidades">Modalidades</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#quienes-somos">Quiénes somos</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#preguntas">Preguntas</a>
    </nav>

    <!-- CTA Button sin iconito predeterminado y con borde menos redondeado (rounded-xl) -->
    <div class="flex items-center gap-4 shrink-0">
      <a class="inline-flex items-center justify-center bg-[#fdfbf7] text-[#4a0002] text-[14px] font-semibold px-6 py-2.5 rounded-xl hover:bg-terracota hover:text-white transition-all duration-300 shadow-[0_4px_16px_rgba(0,0,0,0.25)] hover:-translate-y-0.5 active:translate-y-0" href="https://wa.me/?text=Hola%2C%20quisiera%20consultar%20por%20un%20turno%20en%20Primera%20Pausa" rel="noopener noreferrer" target="_blank">
        <span>Necesito hablar</span>
      </a>
    </div>
  </div>
</header>

<main class="w-full">
  <!-- ==================== 1. HERO SECTION (MÁS GRANDE, ANIMADO AL ENTRAR Y VOCES DESTAPADAS) ==================== -->
  <section class="relative w-full bg-[#4a0002] text-white overflow-hidden py-16 lg:py-24 border-b border-[#631014]">
    <!-- Ambient aura glow -->
    <div class="pointer-events-none absolute -top-40 -left-40 w-[600px] h-[600px] rounded-full bg-[#7a060a] blur-[120px] animate-ambient-glow -z-0"></div>
    <div class="pointer-events-none absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-[#360002] blur-[100px] -z-0"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Columna Izquierda: Titular más grande + animación de escritura -->
        <div class="lg:col-span-7 flex flex-col items-start gap-6 reveal-init">
          <div class="text-[12px] uppercase tracking-[0.2em] text-[#ffdad5]/80 font-semibold">
            ORIENTACIÓN PSICOLÓGICA PUNTUAL
          </div>

          <div class="relative">
            <!-- Tamaño aumentado como pidieron Barbi y Lucía + efecto escritura -->
            <h1 class="font-serif text-6xl sm:text-7xl lg:text-[88px] font-bold tracking-tight text-white mb-3 leading-[1.02] min-h-[125px] sm:min-h-[150px] lg:min-h-[180px]">
              <span id="hero-word-1">NECESITÁS</span>
              <span class="block italic font-normal text-terracota-light text-6xl sm:text-7xl lg:text-[86px] -mt-1 lg:-mt-2" id="hero-word-2">
                hablar.
              </span>
            </h1>
            <!-- Badge terracota con borde menos redondeado -->
            <div class="inline-block mt-2 px-4 py-1.5 rounded-lg bg-terracota text-white text-xs sm:text-sm font-semibold tracking-wide shadow-md">
              No necesariamente hacer terapia.
            </div>
          </div>

          <!-- Bajada con tipografía más firme -->
          <p class="font-sans text-base sm:text-lg text-[#ffdad5]/95 font-medium max-w-xl leading-relaxed pt-1">
            Una conversación profesional para entender mejor lo que te está pasando, ordenar la situación y pensar cómo abordarla.
          </p>

          <!-- Botones duales del Hero: SIN iconitos predeterminados y con esquinas menos redondas (rounded-xl) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto pt-4">
            <a class="inline-flex items-center justify-center bg-[#fdfbf7] text-[#4a0002] font-semibold text-sm sm:text-base px-8 py-3.5 rounded-xl shadow-[0_8px_24px_rgba(0,0,0,0.25)] hover:bg-[#ffdad5] hover:-translate-y-0.5 transition-all duration-300" href="https://wa.me/?text=Hola%2C%20quisiera%20consultar%20por%20un%20turno%20en%20Primera%20Pausa" rel="noopener noreferrer" target="_blank">
              <span>Necesito hablar</span>
            </a>
            <a class="inline-flex items-center justify-center bg-[#2d0001] text-white border border-[#852327] font-semibold text-sm sm:text-base px-8 py-3.5 rounded-xl hover:bg-terracota hover:border-terracota hover:-translate-y-0.5 transition-all duration-300" href="https://wa.me/?text=Hola%2C%20necesito%20hablar%20hoy%20mismo%20con%20una%20profesional%20en%20Primera%20Pausa" rel="noopener noreferrer" target="_blank">
              <span>Necesito hablar hoy</span>
            </a>
          </div>

          <div class="flex items-center gap-2 pt-2 text-xs text-[#ffdad5]/75">
            <span>Turnos sujetos a disponibilidad. No es un servicio de emergencia ni guardia.</span>
          </div>
        </div>

        <!-- Columna Derecha: "ENTRE TANTAS VOCES" con las frases de fondo claras y SIN tapar por el cuadro central -->
        <div class="lg:col-span-5 relative flex items-center justify-center min-h-[400px] lg:min-h-[450px] reveal-init" style="transition-delay: 150ms;">
          <div class="relative w-full h-full p-6 sm:p-8 rounded-2xl bg-[#3a0002]/70 border border-[#6b151a] overflow-hidden flex flex-col justify-between items-center shadow-inner gap-5">
            
            <!-- Voces superiores despejadas (se leen completas) -->
            <div class="w-full flex flex-wrap justify-between items-center gap-y-3 gap-x-4 pt-1">
              <div class="chatter-voice text-xs sm:text-sm">“YO EN TU LUGAR...”</div>
              <div class="chatter-voice text-xs sm:text-sm">“TENÉS QUE DEJARLO”</div>
              <div class="chatter-voice text-xs">“NO ES PARA TANTO”</div>
              <div class="chatter-voice text-xs sm:text-sm">“YA VA A PASAR...”</div>
            </div>

            <!-- Centro tipográfico destacado (no pisa las frases de arriba ni las de abajo) -->
            <div class="relative z-10 text-center px-6 py-7 w-full max-w-sm rounded-xl bg-[#4a0002]/95 border border-[#ffdad5]/25 shadow-xl my-2">
              <span class="text-[11px] uppercase tracking-[0.25em] text-[#ffdad5]/85 font-semibold block mb-2">
                ENTRE TANTAS VOCES
              </span>
              <h3 class="font-serif italic text-3xl sm:text-4xl text-[#ffc7bf] font-medium leading-tight">
                ¿qué necesitás vos?
              </h3>
              <div class="w-12 h-0.5 bg-terracota mx-auto mt-4 rounded-full"></div>
            </div>

            <!-- Voces inferiores despejadas (se leen completas) -->
            <div class="w-full flex flex-wrap justify-between items-center gap-y-3 gap-x-4 pb-1">
              <div class="chatter-voice text-xs sm:text-sm">“DEBERÍAS HABLARLO”</div>
              <div class="chatter-voice text-xs sm:text-sm">“PENSÁ EN VOS”</div>
              <div class="chatter-voice text-xs sm:text-sm ml-auto">“NO LE DES TANTAS VUELTAS”</div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. SECCIÓN: SITUACIONES (SIN DIBUJITOS Y TIPOGRAFÍA MÁS FIRME) ==================== -->
  <section class="w-full bg-[#3d0002] text-white py-20 lg:py-28 relative overflow-hidden" id="situaciones">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col gap-14">
      <!-- Encabezado reflexivo (Tipografía firme y clara, punto 2 de Lucía) -->
      <div class="max-w-3xl reveal-init">
        <p class="font-sans text-2xl sm:text-3xl text-[#ffdad5] leading-snug font-semibold tracking-tight">
          Hay situaciones que no necesitan un tratamiento, sino una conversación a tiempo con alguien que sabe escuchar y ordenar.
        </p>
      </div>

      <!-- Las 3 tarjetas SIN los dibujitos de corazón/valija y con tipografía firme sin cursiva blanda (Puntos 3 y 4 de Lucía) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <!-- Tarjeta 1: VÍNCULOS -->
        <div class="relative bg-[#4e0205] rounded-2xl p-8 border border-[#78181e] flex flex-col justify-between min-h-[250px] shadow-lg overflow-hidden group hover:border-terracota transition-all duration-300 reveal-init">
          <div class="absolute -top-4 -left-2 font-serif text-[110px] font-bold text-white/5 select-none pointer-events-none group-hover:text-white/10 transition-colors">
            01
          </div>
          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class="font-sans text-xs font-bold tracking-widest text-terracota-light">01</span>
              <h3 class="font-sans text-terracota font-bold tracking-[0.15em] text-sm lg:text-base uppercase">
                VÍNCULOS
              </h3>
              <div class="flex-1 h-[1px] bg-terracota/40"></div>
            </div>
            <p class="font-sans font-semibold text-xl sm:text-2xl text-white pt-2 leading-snug">
              “Discutí con mi pareja y no sé qué hacer.”
            </p>
          </div>
          <div class="relative z-10 pt-4 flex items-center gap-2 text-xs text-[#ffdad5]/80">
            <span class="text-terracota font-bold">→</span>
            <span>Desarmar la escalada y clarificar límites saludables</span>
          </div>
        </div>

        <!-- Tarjeta 2: DECISIONES -->
        <div class="relative bg-[#4e0205] rounded-2xl p-8 border border-[#78181e] flex flex-col justify-between min-h-[250px] shadow-lg overflow-hidden group hover:border-terracota transition-all duration-300 reveal-init" style="transition-delay: 100ms;">
          <div class="absolute -top-4 -left-2 font-serif text-[110px] font-bold text-white/5 select-none pointer-events-none group-hover:text-white/10 transition-colors">
            02
          </div>
          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class="font-sans text-xs font-bold tracking-widest text-terracota-light">02</span>
              <h3 class="font-sans text-terracota font-bold tracking-[0.15em] text-sm lg:text-base uppercase">
                DECISIONES
              </h3>
              <div class="flex-1 h-[1px] bg-terracota/40"></div>
            </div>
            <p class="font-sans font-semibold text-xl sm:text-2xl text-white pt-2 leading-snug">
              “Tengo que tomar una decisión importante y estoy trabadísima.”
            </p>
          </div>
          <div class="relative z-10 pt-4 flex items-center gap-2 text-xs text-[#ffdad5]/80">
            <span class="text-terracota font-bold">→</span>
            <span>Mitigar la parálisis y ordenar alternativas posibles</span>
          </div>
        </div>

        <!-- Tarjeta 3: TRABAJO -->
        <div class="relative bg-[#4e0205] rounded-2xl p-8 border border-[#78181e] flex flex-col justify-between min-h-[250px] shadow-lg overflow-hidden group hover:border-terracota transition-all duration-300 reveal-init" style="transition-delay: 200ms;">
          <div class="absolute -top-4 -left-2 font-serif text-[110px] font-bold text-white/5 select-none pointer-events-none group-hover:text-white/10 transition-colors">
            03
          </div>
          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class="font-sans text-xs font-bold tracking-widest text-terracota-light">03</span>
              <h3 class="font-sans text-terracota font-bold tracking-[0.15em] text-sm lg:text-base uppercase">
                TRABAJO
              </h3>
              <div class="flex-1 h-[1px] bg-terracota/40"></div>
            </div>
            <p class="font-sans font-semibold text-xl sm:text-2xl text-white pt-2 leading-snug">
              “Pasó algo en el trabajo y no puedo dejar de pensarlo.”
            </p>
          </div>
          <div class="relative z-10 pt-4 flex items-center gap-2 text-xs text-[#ffdad5]/80">
            <span class="text-terracota font-bold">→</span>
            <span>Despejar la rumia y recuperar serenidad operativa</span>
          </div>
        </div>
      </div>

      <!-- Módulo Inferior: Lista de situaciones orientativas -->
      <div class="bg-[#2c0002]/70 rounded-2xl p-8 lg:p-12 border border-[#6b151a] flex flex-col lg:flex-row gap-8 lg:gap-16 items-start justify-between reveal-init">
        <div class="max-w-md flex flex-col gap-3">
          <h4 class="font-serif text-2xl lg:text-3xl font-bold text-white leading-tight">
            ¿En qué situaciones podemos orientarte?
          </h4>
          <p class="text-sm text-[#ffdad5]/75">
            Algunos ejemplos de lo que suele traer a una Primera Pausa:
          </p>
        </div>
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm sm:text-base text-[#ffdad5]">
          <div class="flex items-start gap-3">
            <span class="text-terracota font-bold text-lg select-none">→</span>
            <span>Algo que pasó hoy y necesitás pensar.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota font-bold text-lg select-none">→</span>
            <span>Una decisión que no sabés cómo abordar.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota font-bold text-lg select-none">→</span>
            <span>Un conflicto de pareja o familiar.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota font-bold text-lg select-none">→</span>
            <span>Un conflicto laboral.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota font-bold text-lg select-none">→</span>
            <span>Preparar una conversación importante.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-terracota font-bold text-lg select-none">→</span>
            <span>Algo que te está generando preocupación, angustia o confusión.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. SECCIÓN INTACTA: ¿QUÉ PODEMOS TRABAJAR? ("Esto me re gusta") ==================== -->
  <section class="w-full bg-[#4a0002] text-white py-20 lg:py-28 relative overflow-hidden" id="que-trabajamos">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col gap-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 reveal-init">
        <div class="max-w-2xl flex flex-col gap-2">
          <span class="text-[12px] uppercase tracking-[0.2em] text-[#ffdad5]/75 font-semibold">
            UNA CONVERSACIÓN CON FOCO
          </span>
          <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
            ¿QUÉ PODEMOS TRABAJAR?
            <span class="block italic font-normal text-terracota-light text-3xl sm:text-4xl lg:text-5xl mt-1">
              en una Primera Pausa
            </span>
          </h2>
        </div>
        <p class="text-sm sm:text-base text-[#ffdad5]/85 max-w-md leading-relaxed">
          Según la situación, la conversación puede ayudarnos a distinguir, clarificar, ordenar y considerar alternativas.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8 flex flex-col gap-8 relative reveal-init">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 relative">
            <div class="relative p-6 rounded-xl bg-[#570509]/70 border border-[#7d171d] hover:border-terracota transition-all duration-300">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-2.5 h-2.5 rounded-full bg-terracota"></span>
                <span class="font-serif text-lg font-bold tracking-wide text-white uppercase">
                  DISTINGUIR
                </span>
              </div>
              <p class="text-sm text-[#ffdad5]/85 leading-relaxed">
                Qué está influyendo en la situación.
              </p>
            </div>

            <div class="relative p-6 rounded-xl bg-[#570509]/70 border border-[#7d171d] hover:border-terracota transition-all duration-300">
              <div class="flex items-center gap-2 mb-2">
                <span class="w-2.5 h-2.5 rounded-full bg-terracota"></span>
                <span class="font-serif text-lg font-bold tracking-wide text-white uppercase">
                  CLARIFICAR
                </span>
              </div>
              <p class="text-sm text-[#ffdad5]/85 leading-relaxed">
                Qué necesitás en este momento.
              </p>

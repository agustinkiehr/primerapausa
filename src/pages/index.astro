<script is:inline>
  // 0. Animación letra por letra de "NECESITÁS hablar."
  (function animateHeroTitle() {
    const l1 = document.getElementById('anim-line-1');
    const l2 = document.getElementById('anim-line-2');
    if (!l1 || !l2) return;

    const wrapChars = (el, baseDelay) => {
      const text = el.textContent.trim();
      el.innerHTML = '';
      [...text].forEach((ch, idx) => {
        const span = document.createElement('span');
        span.className = 'char-anim';
        span.style.animationDelay = `${baseDelay + idx * 0.055}s`;
        span.textContent = ch === ' ' ? '\u00A0' : ch;
        el.appendChild(span);
      });
    };

    wrapChars(l1, 0.1);
    wrapChars(l2, 0.65);
  })();

  // 1. Slider interactivo conectado a /solicitar?modalidad=...
  const mentalSlider = document.getElementById('mental-load-slider');
  const sliderLevelTitle = document.getElementById('slider-level-title');
  const sliderIntensityBadge = document.getElementById('slider-intensity-badge');
  const sliderSuggestionTag = document.getElementById('slider-suggestion-tag');
  const sliderMessageText = document.getElementById('slider-message-text');
  const sliderCtaBtn = document.getElementById('slider-cta-btn');
  const sliderTickBtns = document.querySelectorAll('.slider-tick-btn');

  const mentalLevels = {
    1: {
      title: "Nivel 1: Ruido ligero",
      badge: "Claridad general",
      suggestion: "Sugerencia: Pausa Breve (30 min)",
      message: "“A veces solo hace falta desenredar un pensamiento incipiente antes de que crezca y tome más espacio.”",
      url: "/solicitar?modalidad=breve"
    },
    2: {
      title: "Nivel 2: Rumia mental",
      badge: "Fricción incipiente",
      suggestion: "Sugerencia: Pausa Breve (30 min) o Estándar (60 min)",
      message: "“A veces solo hace falta desenredar un pensamiento recurrente antes de que crezca. Una conversación a tiempo devuelve el control.”",
      url: "/solicitar?modalidad=estandar"
    },
    3: {
      title: "Nivel 3: Trabada en un dilema",
      badge: "Parálisis por análisis",
      suggestion: "Sugerencia: Pausa Estándar (60 min)",
      message: "“La sensación de estar trabada consume más energía que la decisión misma. Vamos a ordenarlo juntas paso a paso.”",
      url: "/solicitar?modalidad=estandar"
    },
    4: {
      title: "Nivel 4: Carga abrumadora",
      badge: "Saturación emocional",
      suggestion: "Sugerencia: Pausa Extendida (90 min)",
      message: "“Cuando todo se siente urgente, una pausa guiada de 60 o 90 min te devuelve el eje y baja la sobrecarga hoy mismo.”",
      url: "/solicitar?modalidad=extendida"
    },
    5: {
      title: "Nivel 5: Al límite",
      badge: "Atención prioritaria",
      suggestion: "Sugerencia: Pausa Prioritaria (<24hs)",
      message: "“Cuando la angustia o el estrés te desbordan, contar con una profesional en el día es la prioridad.”",
      url: "/solicitar?modalidad=prioritaria"
    }
  };

  function updateSlider(val) {
    const data = mentalLevels[val];
    if (!data) return;
    sliderLevelTitle.innerText = data.title;
    sliderIntensityBadge.innerText = data.badge;
    sliderSuggestionTag.innerText = data.suggestion;
    sliderMessageText.innerText = data.message;
    sliderCtaBtn.href = data.url;

    sliderTickBtns.forEach(btn => {
      if (btn.getAttribute('data-val') === String(val)) {
        btn.classList.add('font-bold', 'text-terracota-light');
      } else {
        btn.classList.remove('font-bold', 'text-terracota-light');
      }
    });
  }

  if (mentalSlider) {
    mentalSlider.addEventListener('input', (e) => updateSlider(e.target.value));
    sliderTickBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mentalSlider.value = btn.getAttribute('data-val');
        updateSlider(btn.getAttribute('data-val'));
      });
    });
  }

  // 2. FAQ Accordion
  document.querySelectorAll('.faq-trigger').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.faq-item');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      const isOpen = !content.classList.contains('hidden');

      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => i.classList.remove('rotate-180'));

      if (!isOpen) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
      }
    });
  });

  // 3. Subtle IntersectionObserver reveals
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-visible');
        obs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.reveal-init').forEach(el => observer.observe(el));
</script>
</body>

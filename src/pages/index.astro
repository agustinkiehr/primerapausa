---
// src/pages/index.astro — Nuevo orden de conversión, botones rectos editoriales (ref fotos), cartel cuadrado y módulo "Respirar conmigo"
---
<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Primera Pausa — Orientación Psicológica Puntual</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  
  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#4a0002",
            "primary-dark": "#360002",
            "primary-container": "#6b0003",
            "on-primary": "#ffffff",
            "terracota": "#d9531e",
            "terracota-light": "#e06d3b",
            "terracota-warm": "#d87444",
            "surface": "#fcf9f3",
            "on-surface": "#1c1c18",
            "secondary-container": "#ffc7bf",
            "secondary-fixed": "#ffdad5",
            "outline": "#8c716d",
          },
          fontFamily: {
            "serif": ["Playfair Display", "serif"],
            "sans": ["Plus Jakarta Sans", "sans-serif"],
          }
        }
      }
    };
  </script>

  <style is:inline>
    html, body { margin: 0; padding: 0; background-color: #3d0002; }
    body { overscroll-behavior: none; }
    ::-webkit-scrollbar { display: none; }

    /* Animaciones de revelado al hacer scroll */
    .reveal-init {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .reveal-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes subtlePulse {
      0%, 100% { opacity: 0.18; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(1.08); }
    }
    .animate-ambient-glow {
      animation: subtlePulse 7s ease-in-out infinite;
    }

    /* Microanimación letra por letra de "NECESITÁS hablar." */
    @keyframes charReveal {
      0% { opacity: 0; filter: blur(6px); transform: translateY(10px); }
      100% { opacity: 1; filter: blur(0px); transform: translateY(0); }
    }
    .char-anim {
      display: inline-block;
      opacity: 0;
      animation: charReveal 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fadeSlideUp {
      0% { opacity: 0; transform: translateY(16px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .hero-cascade-1 { opacity: 0; animation: fadeSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.05s forwards; }
    .hero-cascade-2 { opacity: 0; animation: fadeSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.3s forwards; }
    .hero-cascade-3 { opacity: 0; animation: fadeSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.55s forwards; }

    /* Movimiento flotante de voces */
    @keyframes floatVoiceA {
      0%, 100% { transform: translate(0px, 0px); opacity: 0.5; }
      50% { transform: translate(4px, -5px); opacity: 0.9; }
    }
    @keyframes floatVoiceB {
      0%, 100% { transform: translate(0px, 0px); opacity: 0.82; }
      50% { transform: translate(-4px, 5px); opacity: 0.45; }
    }
    .voice-anim-a { animation: floatVoiceA 5s ease-in-out infinite; }
    .voice-anim-b { animation: floatVoiceB 6s ease-in-out infinite; }

    /* ==========================================================================
       SISTEMA DE BOTONES EDITORIALES CUADRADOS (INSPIRADO EN FOTOS DE REFERENCIA)
       ========================================================================== */
    .btn-editorial-primary {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      background-color: #d9531e;
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 1.1rem 1.75rem;
      border-radius: 0px;
      border: 1px solid #ff8b57;
      box-shadow: 5px 5px 0px rgba(253, 251, 247, 0.22);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-editorial-primary:hover {
      background-color: #e06d3b;
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0px rgba(253, 251, 247, 0.4);
    }

    .btn-editorial-ivory {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      background-color: #fdfbf7;
      color: #3d0002;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 1.1rem 1.75rem;
      border-radius: 0px;
      border: 1px solid #fdfbf7;
      box-shadow: 5px 5px 0px #d9531e;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-editorial-ivory:hover {
      background-color: #ffdad5;
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0px #e06d3b;
    }

    .btn-editorial-outline {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      background-color: rgba(45, 0, 1, 0.85);
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 1.1rem 1.75rem;
      border-radius: 0px;
      border: 1px solid #e06d3b;
      box-shadow: 5px 5px 0px rgba(217, 83, 30, 0.28);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-editorial-outline:hover {
      background-color: #d9531e;
      border-color: #ffffff;
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0px rgba(255, 255, 255, 0.25);
    }

    /* Flecha lineal vectorial estilo referencia que se alarga en hover */
    .btn-arrow-line {
      display: inline-flex;
      align-items: center;
      transition: transform 0.25s ease;
    }
    .btn-editorial-primary:hover .btn-arrow-line,
    .btn-editorial-ivory:hover .btn-arrow-line,
    .btn-editorial-outline:hover .btn-arrow-line {
      transform: translateX(5px);
    }

    /* Círculo de respiración "Respirar conmigo" */
    .breath-orb {
      transition: transform 4s ease-in-out, background-color 4s ease-in-out, box-shadow 4s ease-in-out;
    }
    .breath-inhale {
      transform: scale(1.38);
      background-color: rgba(217, 83, 30, 0.35);
      box-shadow: 0 0 50px rgba(224, 109, 59, 0.45);
    }
    .breath-hold {
      transform: scale(1.38);
      background-color: rgba(224, 109, 59, 0.5);
      box-shadow: 0 0 65px rgba(255, 199, 191, 0.5);
    }
    .breath-exhale {
      transform: scale(1);
      background-color: rgba(107, 0, 3, 0.5);
      box-shadow: 0 0 20px rgba(217, 83, 30, 0.15);
    }

    /* Slider thumb cuadrado */
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 0px;
      background: #e06d3b;
      border: 2px solid #fdfbf7;
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.4);
      transition: transform 0.2s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }
  </style>
</head>
<body class="bg-[#3d0002] font-sans text-white antialiased selection:bg-terracota selection:text-white pb-20 lg:pb-0">

<!-- ==================== HEADER STICKY (Botón que te sigue: MÁS GRANDE, MAYÚSCULA, NARANJA Y CUADRADO) ==================== -->
<header class="sticky top-0 left-0 w-full z-50 bg-[#2d0001]/95 backdrop-blur-md border-b border-[#78181e] transition-all duration-300">
  <div class="h-20 lg:h-24 max-w-7xl mx-auto px-5 sm:px-6 lg:px-12 flex items-center justify-between gap-6">
    <a class="flex items-center gap-3 shrink-0 group" href="/">
      <div class="w-8 h-8 bg-terracota text-white flex items-center justify-center font-bold tracking-tighter text-xs shadow-sm group-hover:bg-terracota-light transition-colors">
        <span class="inline-block tracking-[-2px] text-sm font-black">||</span>
      </div>
      <span class="font-serif text-2xl font-bold tracking-tight text-white">Primera Pausa</span>
    </a>

    <nav class="hidden xl:flex items-center gap-7 text-[14px] font-medium text-[#ffdad5]/85">
      <a class="hover:text-terracota-light transition-colors duration-200" href="#respirar">Pausa</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#situaciones">Situaciones</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#modalidades">Modalidades y Precios</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#que-trabajamos">Qué trabajamos</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#como-funciona">Cómo funciona</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#quienes-somos">Quiénes somos</a>
      <a class="hover:text-terracota-light transition-colors duration-200" href="#preguntas">Preguntas</a>
    </nav>

    <!-- Botón sticky llamativo en naranja terracota, mayúsculas, más grande y cuadrado -->
    <div class="flex items-center gap-4 shrink-0">
      <a class="inline-flex items-center gap-3 bg-terracota hover:bg-terracota-light text-white text-xs sm:text-sm font-bold uppercase tracking-[0.15em] px-5 sm:px-7 py-3.5 border border-[#ff9d70] shadow-[4px_4px_0px_#fdfbf7] hover:shadow-[6px_6px_0px_#ffffff] hover:-translate-y-0.5 transition-all duration-200" href="/solicitar">
        <span>NECESITÁS HABLAR</span>
        <span class="text-base leading-none">⟶</span>
      </a>
    </div>
  </div>
</header>

<main class="w-full">
  <!-- ==================== 1. HERO SECTION ==================== -->
  <section class="relative w-full bg-[#4a0002] text-white overflow-hidden py-14 sm:py-20 lg:py-24 border-b border-[#631014]">
    <div class="pointer-events-none absolute -top-40 -left-40 w-[600px] h-[600px] rounded-full bg-[#7a060a] blur-[120px] animate-ambient-glow -z-0"></div>
    <div class="pointer-events-none absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-[#360002] blur-[100px] -z-0"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        <!-- Columna Izquierda -->
        <div class="lg:col-span-7 flex flex-col items-start gap-6">
          <div class="text-[12px] uppercase tracking-[0.22em] text-[#ffdad5]/85 font-semibold border-l-2 border-terracota pl-3">
            ORIENTACIÓN PSICOLÓGICA PUNTUAL
          </div>

          <div class="relative">
            <h1 class="font-serif text-6xl sm:text-7xl lg:text-[90px] font-bold tracking-tight text-white mb-4 leading-[1.02]" id="animated-hero-title" aria-label="Necesitás hablar.">
              <span class="block" id="anim-line-1">NECESITÁS</span>
              <span class="block italic font-normal text-terracota-light text-6xl sm:text-7xl lg:text-[88px] -mt-1 lg:-mt-2" id="anim-line-2">hablar.</span>
            </h1>
            <!-- Etiqueta cuadrada -->
            <div class="hero-cascade-1 inline-block mt-1 px-4 py-1.5 bg-terracota text-white text-xs sm:text-sm font-semibold tracking-wide">
              No necesariamente hacer terapia.
            </div>
          </div>

          <p class="hero-cascade-2 font-sans text-base sm:text-lg text-[#ffdad5]/95 font-medium max-w-xl leading-relaxed pt-1">
            Una conversación profesional para entender mejor lo que te está pasando, ordenar la situación y pensar cómo abordarla.
          </p>

          <!-- Botones llamativos cuadrados estilo fotos de referencia (offset + flecha larga) -->
          <div class="hero-cascade-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-5 w-full sm:w-auto pt-4">
            <a class="btn-editorial-ivory" href="/solicitar">
              <span>NECESITO HABLAR</span>
              <span class="btn-arrow-line" aria-hidden="true">───→</span>
            </a>
            <a class="btn-editorial-outline" href="/solicitar?modalidad=prioritaria">
              <span>NECESITO HABLAR HOY</span>
              <span class="btn-arrow-line text-terracota-light" aria-hidden="true">───→</span>
            </a>
          </div>

          <div class="hero-cascade-3 flex items-center gap-2 pt-3 text-xs text-[#ffdad5]/75">
            <span>Turnos sujetos a disponibilidad. No es un servicio de emergencia ni guardia.</span>
          </div>
        </div>

        <!-- Columna Derecha: "ENTRE TANTAS VOCES" y Cartel "¿qué necesitás vos?" EN FORMATO CUADRADO -->
        <div class="lg:col-span-5 relative flex items-center justify-center">
          <div class="relative w-full max-w-[460px] aspect-square p-6 sm:p-8 bg-[#3a0002]/85 border border-[#78181e] overflow-hidden flex flex-col justify-between items-center shadow-2xl">
            <div class="relative z-10 w-full flex flex-wrap justify-between items-center gap-y-2.5 gap-x-4 text-[#ffdad5] font-bold tracking-wider uppercase">
              <span class="voice-anim-a text-xs sm:text-sm">“YO EN TU LUGAR...”</span>
              <span class="voice-anim-b text-xs sm:text-sm">“TENÉS QUE DEJARLO”</span>
              <span class="voice-anim-a text-xs" style="animation-delay: 1.2s;">“NO ES PARA TANTO”</span>
              <span class="voice-anim-b text-xs sm:text-sm" style="animation-delay: 0.7s;">“YA VA A PASAR...”</span>
            </div>

            <!-- Cartel central estrictamente cuadrado/recto (sin bordes redondeados) -->
            <div class="relative z-10 text-center px-6 py-8 w-full max-w-[300px] aspect-[4/3] flex flex-col items-center justify-center bg-[#4a0002] border-2 border-[#ffdad5]/35 shadow-[6px_6px_0px_rgba(217,83,30,0.45)] my-2">
              <span class="text-[11px] uppercase tracking-[0.25em] text-[#ffdad5]/85 font-semibold block mb-2">
                ENTRE TANTAS VOCES
              </span>
              <h2 class="font-serif italic text-3xl sm:text-4xl text-[#ffc7bf] font-medium leading-tight">
                ¿qué necesitás vos?
              </h2>
              <div class="w-12 h-0.5 bg-terracota mx-auto mt-4"></div>
            </div>

            <div class="relative z-10 w-full flex flex-wrap justify-between items-center gap-y-2.5 gap-x-4 text-[#ffdad5] font-bold tracking-wider uppercase">
              <span class="voice-anim-b text-xs sm:text-sm" style="animation-delay: 0.5s;">“DEBERÍAS HABLARLO”</span>
              <span class="voice-anim-a text-xs sm:text-sm" style="animation-delay: 1.5s;">“PENSÁ EN VOS”</span>
              <span class="voice-anim-b text-xs sm:text-sm ml-auto" style="animation-delay: 2.1s;">“NO LE DES TANTAS VUELTAS”</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 1.B MÓDULO RECUPERADO: "RESPIRAR CONMIGO" ==================== -->
  <section class="w-full bg-[#2c0002] border-b border-[#631014] py-12 sm:py-16 text-white" id="respirar">
    <div class="max-w-5xl mx-auto px-6 lg:px-12">
      <div class="bg-[#3d0002] border border-[#78181e] p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl reveal-init">
        <div class="flex flex-col gap-2.5 max-w-lg text-center md:text-left">
          <span class="text-[11px] uppercase tracking-[0.22em] text-terracota-light font-bold">
            ANTES DE SEGUIR, UNA PAUSA
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white">
            Tomate un instante
          </h2>
          <p class="text-sm sm:text-base text-[#ffdad5]/85 leading-relaxed" id="breath-instruction">
            Inhalá, sostené y soltá el aire, 4 segundos cada vez. Un minuto para bajar el ruido antes de leer.
          </p>
          <div class="pt-3 flex justify-center md:justify-start">
            <button type="button" id="breath-toggle-btn" class="btn-editorial-outline py-3 px-6 text-xs">
              <span id="breath-btn-text">RESPIRAR CONMIGO</span>
              <span class="btn-arrow-line text-terracota-light" aria-hidden="true">───→</span>
            </button>
          </div>
        </div>

        <!-- Círculo visual de respiración guiada -->
        <div class="relative w-40 h-40 sm:w-44 sm:h-44 flex items-center justify-center shrink-0">
          <div id="breath-circle" class="breath-orb breath-exhale w-28 h-28 rounded-full border border-terracota-light/60 flex flex-col items-center justify-center text-center p-3">
            <span id="breath-phase-label" class="font-serif italic text-lg text-[#ffc7bf] leading-none">Pausa</span>
            <span id="breath-timer" class="text-xs font-bold tracking-widest text-white/80 mt-1 uppercase">4 seg</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. SECCIÓN: SITUACIONES (Textos y tipografía corregidos) ==================== -->
  <section class="w-full bg-[#3d0002] text-white py-20 lg:py-28 relative overflow-hidden border-b border-[#631014]" id="situaciones">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col gap-14">
      <!-- Cambio solicitado: "alguien que sepa escuchar y ordenar" -->
      <div class="max-w-3xl reveal-init">
        <p class="font-sans text-2xl sm:text-3xl text-[#ffdad5] leading-snug font-semibold tracking-tight">
          Hay situaciones que no necesitan un tratamiento, sino una conversación a tiempo con alguien que sepa escuchar y ordenar.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <!-- Tarjeta 1: VÍNCULOS (Tipografía cambiada a font-serif igual a "¿En qué situaciones podemos orientarte?") -->
        <a href="/solicitar" class="relative bg-[#4e0205] p-8 border border-[#78181e] flex flex-col justify-between min-h-[250px] shadow-lg overflow-hidden group hover:border-terracota transition-all duration-300 reveal-init">
          <div class="absolute -top-4 -left-2 font-serif text-[110px] font-bold text-white/5 select-none pointer-events-none group-hover:text-white/10 transition-colors">
            01
          </div>
          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class="font-sans text-xs font-bold tracking-widest text-terracota-light">01</span>
              <h3 class="font-sans text-terracota font-bold tracking-[0.15em] text-sm lg:text-base uppercase">
                VÍNCULOS
              </h3>
              <div class="flex-1 h-[1px] bg-terracota/40"></div>
            </div>
            <p class="font-serif font-bold text-xl sm:text-2xl text-white pt-2 leading-tight">
              “Discutí con mi pareja y no sé qué hacer.”
            </p>
          </div>
          <div class="relative z-10 pt-4 flex items-center gap-2 text-xs text-[#ffdad5]/80">
            <span class="text-terracota font-bold">→</span>
            <span>Desarmar la escalada y clarificar límites saludables</span>
          </div>
        </a>

        <!-- Tarjeta 2: DECISIONES (Cambio solicitado: "trabadísima/o" + font-serif) -->
        <a href="/solicitar" class="relative bg-[#4e0205] p-8 border border-[#78181e] flex flex-col justify-between min-h-[250px] shadow-lg overflow-hidden group hover:border-terracota transition-all duration-300 reveal-init" style="transition-delay: 100ms;">
          <div class="absolute -top-4 -left-2 font-serif text-[110px] font-bold text-white/5 select-none pointer-events-none group-hover:text-white/10 transition-colors">
            02
          </div>
          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class="font-sans text-xs font-bold tracking-widest text-terracota-light">02</span>
              <h3 class="font-sans text-terracota font-bold tracking-[0.15em] text-sm lg:text-base uppercase">
                DECISIONES
              </h3>
              <div class="flex-1 h-[1px] bg-terracota/40"></div>
            </div>
            <p class="font-serif font-bold text-xl sm:text-2xl text-white pt-2 leading-tight">
              “Tengo que tomar una decisión importante y estoy trabadísima/o.”
            </p>
          </div>
          <div class="relative z-10 pt-4 flex items-center gap-2 text-xs text-[#ffdad5]/80">
            <span class="text-terracota font-bold">→</span>
            <span>Mitigar la parálisis y ordenar alternativas posibles</span>
          </div>
        </a>

        <!-- Tarjeta 3: TRABAJO (font-serif igual a "¿En qué situaciones podemos orientarte?") -->
        <a href="/solicitar" class="relative bg-[#4e0205] p-8 border border-[#78181e] flex flex-col justify-between min-h-[250px] shadow-lg overflow-hidden group hover:border-terracota transition-all duration-300 reveal-init" style="transition-delay: 200ms;">
          <div class="absolute -top-4 -left-2 font-serif text-[110px] font-bold text-white/5 select-none pointer-events-none group-hover:text-white/10 transition-colors">
            03
          </div>
          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class="font-sans text-xs font-bold tracking-widest text-terracota-light">03</span>
              <h3 class="font-sans text-terracota font-bold tracking-[0.15em] text-sm lg:text-base uppercase">
                TRABAJO
              </h3>
              <div class="flex-1 h-[1px] bg-terracota/40"></div>
            </div>
            <p class="font-serif font-bold text-xl sm:text-2xl text-white pt-2 leading-tight">
              “Pasó algo en el trabajo y no puedo dejar de pensarlo.”
            </p>
          </div>
          <div class="relative z-10 pt-4 flex items-center gap-2 text-xs text-[#ffdad5]/80">
            <span class="text-terracota font-bold">→</span>
